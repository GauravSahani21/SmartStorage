PORT=5005

# MongoDB Atlas connection string (required in production)
# Get your URI from: https://cloud.mongodb.com
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/studentvault?retryWrites=true&w=majority&appName=Cluster0

# JWT secret — change this to a long random string in production
JWT_SECRET=change_me_to_a_long_random_secret_string_in_production

NODE_ENV=production

# Your deployed Vercel frontend URL (no trailing slash)
CLIENT_URL=https://your-app.vercel.app

# Google Gemini API Key (get from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
